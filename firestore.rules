// ═══════════════════════════════════════════════════════
// SERVANA — Firestore Security Rules v4.0
//
// Money model enforced here:
//   * Seekers pay the PROVIDER directly after the job and pay no platform fee.
//   * The provider owes `commissionRate`% of serviceFee once they confirm payment.
//   * Commission is marked PAID only by the server (Netlify function using the Admin SDK,
//     which bypasses these rules, after verifying the charge with Paystack).
//   * Ratings and completedJobs can only change together with the real record that justifies
//     the change (a review / a completed booking), verified with getAfter().
// ═══════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Suspension lives on BOTH users/{uid} and providers/{uid}; either blocks writes.
    function notSuspended() {
      return isAuth()
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get("suspended", false) != true)
        && (!exists(/databases/$(database)/documents/providers/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/providers/$(request.auth.uid)).data.get("suspended", false) != true);
    }

    function unchanged(field) {
      return !(field in request.resource.data) ||
             request.resource.data[field] == resource.data[field];
    }
    function notIn(field) {
      return !(field in request.resource.data);
    }
    function incomingIs(field, value) {
      return field in request.resource.data &&
             request.resource.data[field] == value;
    }
    function isChatParticipant(chatId) {
      return isAuth() &&
        request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }
    function validStr(field, maxLen) {
      return field in request.resource.data &&
             request.resource.data[field] is string &&
             request.resource.data[field].size() <= maxLen;
    }
    function validNum(field, min, max) {
      return field in request.resource.data &&
             request.resource.data[field] is number &&
             request.resource.data[field] >= min &&
             request.resource.data[field] <= max;
    }

    // A booking is only valid if it agrees with the AUTHORITATIVE service, provider and
    // platform config: provider/service identity, price, fees, availability, suspension.
    function bookingMatchesService() {
      let d    = request.resource.data;
      let svc  = get(/databases/$(database)/documents/services/$(d.serviceId)).data;
      let prov = get(/databases/$(database)/documents/providers/$(d.providerId)).data;
      let cfg  = exists(/databases/$(database)/documents/config/platform)
                   ? get(/databases/$(database)/documents/config/platform).data
                   : {};
      return svc.providerId == d.providerId
          && svc.get("active", true) != false
          && svc.price is number && svc.price > 0
          && svc.price >= cfg.get("minBooking", 0)
          && d.serviceFee == svc.price
          && d.total      == svc.price
          && d.platformFee == 0
          && d["service"]    == svc.name
          && d.commissionRate == cfg.get("commissionRate", 5)
          && prov.get("suspended", false) != true
          && prov.get("deleted", false)   != true
          && prov.get("isPublic", true)   != false
          && prov.get("available", true)  != false;
    }

    // Provider updating their own profile: these fields are system-owned.
    function touchesLockedProviderField() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "uid","createdAt","verified","suspended","rating","reviewCount","ratingBreakdown",
        "completedJobs","lastReviewedAt","lastReviewBookingId","lastCompletedBookingId",
        "outstandingCommission","lastCommissionPaidAt"
      ]);
    }

    // A rating change is legal only alongside the review that justifies it.
    function reviewAggregationOk(providerId) {
      let n    = request.resource.data;
      let o    = resource.data;
      let bid  = n.lastReviewBookingId;
      let rv   = getAfter(/databases/$(database)/documents/reviews/$(bid)).data;
      let bk   = get(/databases/$(database)/documents/bookings/$(bid)).data;
      let oldC = o.get("reviewCount", 0);
      let oldR = o.get("rating", 0);
      return !exists(/databases/$(database)/documents/reviews/$(bid))
          && existsAfter(/databases/$(database)/documents/reviews/$(bid))
          && rv.providerId == providerId && rv.seekerId == request.auth.uid
          && bk.seekerId   == request.auth.uid && bk.providerId == providerId
          && bk.status == "completed" && bk.get("reviewed", false) != true
          && n.reviewCount == oldC + 1
          && n.rating >= 1 && n.rating <= 5
          && math.abs(n.rating * n.reviewCount - (oldR * oldC + rv.rating)) <= 0.01 * n.reviewCount + 0.01;
    }

    // completedJobs may only go up by one, together with a booking moving accepted -> completed.
    function completedJobsOk(providerId) {
      let n    = request.resource.data;
      let bid  = n.lastCompletedBookingId;
      let pre  = get(/databases/$(database)/documents/bookings/$(bid)).data;
      let post = getAfter(/databases/$(database)/documents/bookings/$(bid)).data;
      return pre.providerId == providerId
          && pre.status == "accepted" && post.status == "completed"
          && n.completedJobs == resource.data.get("completedJobs", 0) + 1;
    }

    // Booking notifications: a user may notify the OTHER party of a booking they share.
    function notifyViaBooking() {
      let n = request.resource.data;
      let b = get(/databases/$(database)/documents/bookings/$(n.data.bookingId)).data;
      return (b.seekerId == request.auth.uid && b.providerId == n.userId)
          || (b.providerId == request.auth.uid && b.seekerId == n.userId);
    }

    // ── USERS (private: owner + admin only) ────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
                       incomingIs("uid", request.auth.uid) &&
                       (!("role" in request.resource.data) ||
                         request.resource.data.role in ["seeker","provider"]) &&
                       notIn("suspended");
      allow update: if isAuth() && (
        (isOwner(userId) && unchanged("uid") && unchanged("role") && unchanged("suspended")) ||
        isAdmin()
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── PROVIDERS (public profile; NO contact or bank data) ──
    match /providers/{providerId} {
      allow read: if true;

      allow create: if isOwner(providerId) &&
                       notIn("email") && notIn("bankName") &&
                       notIn("accountNumber") && notIn("accountName") &&
                       notIn("outstandingCommission") &&
                       (!("verified" in request.resource.data) || request.resource.data.verified == false) &&
                       (!("suspended" in request.resource.data) || request.resource.data.suspended == false) &&
                       (!("rating" in request.resource.data) || request.resource.data.rating == 0) &&
                       (!("reviewCount" in request.resource.data) || request.resource.data.reviewCount == 0) &&
                       (!("completedJobs" in request.resource.data) || request.resource.data.completedJobs == 0);

      allow update: if isAuth() && (
        // own profile, system-owned fields locked
        (isOwner(providerId) && notSuspended() && !touchesLockedProviderField()) ||

        // rating aggregate, only together with the review that justifies it
        (request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["rating","reviewCount","ratingBreakdown","lastReviewedAt","lastReviewBookingId"]) &&
         reviewAggregationOk(providerId)) ||

        // completedJobs +1, only together with a booking becoming completed
        (isOwner(providerId) && notSuspended() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["completedJobs","lastCompletedBookingId","updatedAt"]) &&
         completedJobsOk(providerId)) ||

        isAdmin()
      );

      allow delete: if isOwner(providerId) || isAdmin();

      // Bank/payout details: owner + admin only. Copied into a booking when the provider accepts it.
      match /private/{docId} {
        allow read, write: if isOwner(providerId) || isAdmin();
      }
    }

    // ── SERVICES (top-level, authoritative for identity + price) ──
    match /services/{serviceId} {
      allow read: if true;

      allow create: if isAuth() && notSuspended() &&
                       incomingIs("providerId", request.auth.uid) &&
                       validStr("name", 160) &&
                       validNum("price", 1, 10000000) &&
                       (!("active" in request.resource.data) || request.resource.data.active is bool) &&
                       (!("serviceMode" in request.resource.data) ||
                         request.resource.data.serviceMode in ["onsite","remote","both"]) &&
                       (!("serviceCoverage" in request.resource.data) ||
                         request.resource.data.serviceCoverage in ["city","state"]);

      allow update: if isAuth() && (
        (resource.data.providerId == request.auth.uid && notSuspended() &&
         unchanged("providerId") &&
         validStr("name", 160) && validNum("price", 1, 10000000) &&
         (!("serviceMode" in request.resource.data) ||
           request.resource.data.serviceMode in ["onsite","remote","both"]) &&
         (!("serviceCoverage" in request.resource.data) ||
           request.resource.data.serviceCoverage in ["city","state"])) ||
        isAdmin()
      );

      allow delete: if isAuth() && (resource.data.providerId == request.auth.uid || isAdmin());
    }

    // ── BOOKINGS ───────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAuth() && (
        resource.data.seekerId   == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuth() && notSuspended() &&
                       incomingIs("seekerId", request.auth.uid) &&
                       incomingIs("status", "pending") &&
                       incomingIs("paymentStatus", "awaiting_completion") &&
                       notIn("reviewed") && notIn("commissionAmount") && notIn("providerPaymentAccount") &&
                       validStr("address", 300) &&
                       (!("notes" in request.resource.data) ||
                         (request.resource.data.notes is string && request.resource.data.notes.size() <= 1500)) &&
                       request.resource.data.keys().hasAll([
                         "seekerId","providerId","serviceId","service","serviceFee","platformFee",
                         "commissionRate","date","time","address","status","total"
                       ]) &&
                       request.resource.data.seekerId != request.resource.data.providerId &&
                       bookingMatchesService();

      allow update: if isAuth() && (
        // Seeker cancels a pending booking
        (resource.data.seekerId == request.auth.uid &&
         resource.data.status == "pending" &&
         incomingIs("status","cancelled") &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","updatedAt"])) ||

        // Seeker marks reviewed — only together with the review document
        (resource.data.seekerId == request.auth.uid &&
         resource.data.status == "completed" && resource.data.get("reviewed", false) != true &&
         existsAfter(/databases/$(database)/documents/reviews/$(bookingId)) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["reviewed","reviewedAt","updatedAt"])) ||

        // Seeker submits payment receipt
        (resource.data.seekerId == request.auth.uid &&
         resource.data.status == "completed" &&
         resource.data.get("paymentStatus", "awaiting_completion") == "awaiting_completion" &&
         incomingIs("paymentStatus","payment_submitted") &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["paymentStatus","receiptUrl","receiptUploadedAt","receiptUploadedBy","updatedAt"])) ||

        // Provider accepts (must attach payout details), declines, completes, disputes
        (resource.data.providerId == request.auth.uid && notSuspended() &&
         (
           (resource.data.status=="pending"  && incomingIs("status","accepted") &&
              request.resource.data.providerPaymentAccount is map &&
              request.resource.data.providerPaymentAccount.accountNumber is string &&
              request.resource.data.providerPaymentAccount.accountNumber.size() == 10) ||
           (resource.data.status=="pending"  && incomingIs("status","cancelled")) ||
           (resource.data.status=="accepted" && incomingIs("status","completed")) ||
           (resource.data.status=="accepted" && incomingIs("status","disputed"))
         ) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["status","updatedAt","providerPaymentAccount"])) ||

        // Provider confirms payment received -> commission becomes due.
        // Amount must equal serviceFee * the commissionRate snapshotted on the booking (+/- ₦1 rounding).
        (resource.data.providerId == request.auth.uid &&
         resource.data.status == "completed" &&
         resource.data.paymentStatus == "payment_submitted" &&
         incomingIs("paymentStatus","payment_confirmed") &&
         request.resource.data.commissionAmount is number &&
         request.resource.data.commissionAmount >=
           resource.data.serviceFee * resource.data.get("commissionRate", 5) / 100 - 1 &&
         request.resource.data.commissionAmount <=
           resource.data.serviceFee * resource.data.get("commissionRate", 5) / 100 + 1 &&
         request.resource.data.commissionStatus in ["pending","not_due"] &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(["paymentStatus","providerPaymentConfirmed","paymentConfirmedAt",
                     "commissionStatus","commissionAmount","updatedAt"])) ||

        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // ── CHATS ──────────────────────────────────────────
    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && notSuspended() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.participants.size() == 2 &&
                       request.resource.data.participants[0] != request.resource.data.participants[1] &&
                       "participantNames" in request.resource.data &&
                       request.resource.data.participantNames is map;
      allow update: if isAuth() && request.auth.uid in resource.data.participants &&
                       unchanged("participants") && unchanged("participantNames") &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["lastMessage","lastMessageAt","unread","updatedAt"]);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read:   if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId) && notSuspended() &&
                         incomingIs("senderId", request.auth.uid) &&
                         validStr("text", 2000) &&
                         (!("read" in request.resource.data) || request.resource.data.read == false);
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    // ── REVIEWS: one per booking (document id == booking id) ──
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuth() && notSuspended() &&
                       reviewId == request.resource.data.bookingId &&
                       incomingIs("seekerId", request.auth.uid) &&
                       validNum("rating", 1, 5) &&
                       (!("comment" in request.resource.data) ||
                         (request.resource.data.comment is string &&
                          request.resource.data.comment.size() <= 1000)) &&
                       request.resource.data.keys().hasAll(["bookingId","providerId","seekerId","rating"]) &&
                       request.resource.data.keys().hasOnly(["bookingId","providerId","providerName",
                         "seekerId","seekerName","rating","comment","createdAt"]) &&
                       request.resource.data.seekerId != request.resource.data.providerId &&
                       get(/databases/$(database)/documents/bookings/$(reviewId)).data.seekerId == request.auth.uid &&
                       get(/databases/$(database)/documents/bookings/$(reviewId)).data.providerId == request.resource.data.providerId &&
                       get(/databases/$(database)/documents/bookings/$(reviewId)).data.status == "completed" &&
                       get(/databases/$(database)/documents/bookings/$(reviewId)).data.get("reviewed", false) != true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── CATEGORIES (admin-managed) ─────────────────────
    match /category/{catId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ── NOTIFICATIONS ──────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && notSuspended() &&
                       request.resource.data.keys().hasOnly(["userId","title","body","type","url","data","read","createdAt"]) &&
                       validStr("title", 200) &&
                       (!("body" in request.resource.data) ||
                         (request.resource.data.body is string && request.resource.data.body.size() <= 500)) &&
                       (!("url" in request.resource.data) ||
                         (request.resource.data.url is string &&
                          request.resource.data.url.matches("^(\\./[a-z-]+\\.html(\\?[A-Za-z0-9_=&%.-]*)?)?$"))) &&
                       (!("read" in request.resource.data) || request.resource.data.read == false) &&
                       request.resource.data.userId is string &&
                       (
                         request.resource.data.userId == request.auth.uid ||
                         (request.resource.data.data is map &&
                          request.resource.data.data.bookingId is string &&
                          notifyViaBooking())
                       );
      allow update: if isAuth() && resource.data.userId == request.auth.uid &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(["read","readAt"]);
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // ── CONFIG (platform settings) ─────────────────────
    match /config/{docId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── Server-only ledger of settled commission payments ──
    match /commissionPayments/{ref} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── DENY ALL ELSE ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
